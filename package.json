{
  "name": "johanneserfurt.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test --test-isolation=none tests/schema.test.mjs tests/data.test.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "validate:links": "node scripts/validate_internal_links.mjs",
    "validate": "npm run build && npm run validate:html && npm run validate:links",
    "lighthouse": "node scripts/run_lighthouse.mjs",
    "quality": "npm run check && npm test && npm run validate && npm run lighthouse"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "html-validate": "^11.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
