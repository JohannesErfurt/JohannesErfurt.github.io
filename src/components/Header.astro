---
const githubUrl = 'https://github.com/JohannesErfurt';
const linkedInUrl = 'https://www.linkedin.com/in/johanneserfurt';
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a
      class="font-semibold tracking-tight text-slate-950 outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700"
      href="/"
    >
      Johannes Erfurt
    </a>
    <nav aria-label="Primary navigation">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        <li>
          <a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href="#about">About</a>
        </li>
        <li>
          <a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href="#projects">Projects</a>
        </li>
        <li>
          <a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href={githubUrl}>GitHub</a>
        </li>
        <li>
          <a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href={linkedInUrl}>LinkedIn</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
