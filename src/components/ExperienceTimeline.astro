---
import { experience } from '../data';
import type { TimelineEntry } from '../data/schema';
import CareerJourneyIcon from './CareerJourneyIcon.astro';

type IconKind = 'mathematics' | 'phd' | 'hhi' | 'industry' | 'durham' | 'tomsk' | 'upskilling' | 'travel';

const findEntry = (id: string): TimelineEntry => {
  const entry = experience.find((item) => item.id === id);
  if (!entry) throw new Error(`Missing approved experience entry: ${id}`);
  return entry as TimelineEntry;
};

const scansonic = findEntry('scansonic-ai-developer');
const hhiResearchAssociate = findEntry('fraunhofer-research-associate');
const hhiStudentResearchAssistant = findEntry('fraunhofer-student-research-assistant');
const teachingAssistant = findEntry('tu-berlin-student-teaching-assistant');
const careerTransition = [findEntry('ai-upskilling'), findEntry('sabbatical-world-travel-parental-leave')] as const;
const educationEntries = [
  { entry: findEntry('tu-berlin-phd'), kind: 'phd' as const },
  { entry: findEntry('tu-berlin-msc-mathematics'), kind: 'mathematics' as const },
  { entry: findEntry('tu-berlin-bsc-mathematics'), kind: 'mathematics' as const },
] as const;
const studyAbroadEntries = [
  { entry: findEntry('tomsk-study-abroad'), kind: 'tomsk' as const },
  { entry: findEntry('durham-study-abroad'), kind: 'durham' as const },
] as const;
const colorClass = (kind: IconKind) => ({
  mathematics: 'text-blue-700 dark:text-blue-300', phd: 'text-emerald-700 dark:text-emerald-300',
  hhi: 'text-teal-700 dark:text-teal-300', industry: 'text-violet-700 dark:text-violet-300',
  durham: 'text-purple-700 dark:text-purple-300', tomsk: 'text-green-700 dark:text-green-300',
  upskilling: 'text-cyan-700 dark:text-cyan-300', travel: 'text-amber-700 dark:text-amber-300',
}[kind]);
---

<style is:global>
  section[aria-labelledby="work-experience-title"] > ol,
  section[aria-labelledby="career-transition-title"] > ol,
  section[aria-labelledby="education-title"] > ol,
  section[aria-labelledby="study-abroad-title"] > ol {
    position: relative;
  }

  section[aria-labelledby="work-experience-title"] > ol::before,
  section[aria-labelledby="career-transition-title"] > ol::before,
  section[aria-labelledby="education-title"] > ol::before,
  section[aria-labelledby="study-abroad-title"] > ol::before {
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 2rem;
    width: 1px;
    content: '';
    background: linear-gradient(to bottom, rgb(165 180 252), rgb(129 140 248), rgb(165 180 252));
  }

  section[aria-labelledby="work-experience-title"] > ol > li > article > div > span,
  section[aria-labelledby="career-transition-title"] > ol > li > article > div > span,
  section[aria-labelledby="education-title"] > ol > li > article > div > span,
  section[aria-labelledby="study-abroad-title"] > ol > li > article > div > span {
    position: relative;
    z-index: 1;
    background-color: white;
  }

  .dark section[aria-labelledby="work-experience-title"] > ol > li > article > div > span,
  .dark section[aria-labelledby="career-transition-title"] > ol > li > article > div > span,
  .dark section[aria-labelledby="education-title"] > ol > li > article > div > span,
  .dark section[aria-labelledby="study-abroad-title"] > ol > li > article > div > span {
    background-color: rgb(15 23 42);
  }

  section[aria-labelledby="work-experience-title"] > ol > li > article > div > div > .flex.flex-wrap.items-baseline.justify-between,
  section[aria-labelledby="education-title"] > ol > li > article > div > div > .flex.flex-wrap.items-baseline.justify-between,
  section[aria-labelledby="study-abroad-title"] article:not([data-timeline-id="tomsk-study-abroad"]) .flex.flex-wrap.items-baseline.justify-between {
    display: block;
  }

  section[aria-labelledby="work-experience-title"] > ol > li > article > div > div > .flex.flex-wrap.items-baseline.justify-between .font-mono,
  section[aria-labelledby="education-title"] > ol > li > article > div > div > .flex.flex-wrap.items-baseline.justify-between .font-mono,
  section[aria-labelledby="study-abroad-title"] article:not([data-timeline-id="tomsk-study-abroad"]) .flex.flex-wrap.items-baseline.justify-between .font-mono {
    display: block;
    margin-top: 0.25rem;
  }

  section[aria-labelledby="career-transition-title"] .mt-1.flex.flex-wrap.items-baseline.justify-between,
  article[data-timeline-id="tomsk-study-abroad"] .mt-1.flex.flex-wrap.items-baseline.justify-between {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 0.25rem;
  }
</style>

<section class="mx-auto max-w-6xl px-6 py-16 sm:py-24" id="experience" aria-labelledby="experience-title">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Experience</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl" id="experience-title">From research to real-world AI</h2>
    <p class="mt-4 text-lg leading-8 text-slate-700 dark:text-slate-300">A concise career overview, arranged from most recent to earliest experience in each column.</p>
  </div>

  <div class="mt-12 grid gap-14 lg:grid-cols-2 lg:gap-20">
    <section aria-labelledby="work-experience-title">
      <div class="border-b-2 border-indigo-200 pb-4 dark:border-indigo-900"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Career</p><h3 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white" id="work-experience-title">Work experience</h3></div>
      <ol class="mt-8 space-y-10">
        <li><article aria-labelledby="scansonic-title" data-timeline-id={scansonic.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass('industry')}`}><CareerJourneyIcon kind="industry" /></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">Scansonic MI</p><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">05/2024-Present</p></div><h4 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id="scansonic-title">Software Developer for AI and Image Processing</h4><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{scansonic.summary}</p></div></div></article></li>
        <li><article aria-labelledby="hhi-research-associate-title" data-timeline-id={hhiResearchAssociate.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass('hhi')}`}><CareerJourneyIcon kind="hhi" /></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">Fraunhofer HHI</p><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">09/2015-10/2022</p></div><h4 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id="hhi-research-associate-title">Research Associate</h4><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{hhiResearchAssociate.summary}</p></div></div></article></li>
        <li><article aria-labelledby="hhi-student-research-assistant-title" data-timeline-id={hhiStudentResearchAssistant.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass('hhi')}`}><CareerJourneyIcon kind="hhi" /></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">Fraunhofer HHI</p><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">08/2014-08/2015</p></div><h4 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id="hhi-student-research-assistant-title">Student Research Assistant</h4><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{hhiStudentResearchAssistant.summary}</p></div></div></article></li>
        <li><article aria-labelledby="teaching-assistant-title" data-timeline-id={teachingAssistant.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass('mathematics')}`}><CareerJourneyIcon kind="mathematics" /></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">Technical University of Berlin</p><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">10/2011-09/2014</p></div><h4 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id="teaching-assistant-title">Student Teaching Assistant</h4><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{teachingAssistant.summary}</p></div></div></article></li>
      </ol>
      <section class="mt-14" aria-labelledby="career-transition-title"><div class="border-b-2 border-indigo-200 pb-4 dark:border-indigo-900"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Transition</p><h3 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white" id="career-transition-title">Professional development and personal time</h3></div><ol class="mt-8 space-y-10">{careerTransition.map((entry) => { const kind = entry.id === 'ai-upskilling' ? 'upskilling' : 'travel'; return <li><article aria-labelledby={`${entry.id}-title`} data-timeline-id={entry.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass(kind)}`}><CareerJourneyIcon kind={kind} /></span><div class="min-w-0 flex-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">{entry.organization}</p><div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><h4 class="text-xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${entry.id}-title`}>{entry.role}</h4><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">{entry.period}</p></div><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{entry.summary}</p></div></div></article></li>; })}</ol></section>
    </section>

    <section aria-labelledby="education-title">
      <div class="border-b-2 border-indigo-200 pb-4 dark:border-indigo-900"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Foundation</p><h3 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white" id="education-title">Education</h3></div>
      <ol class="mt-8 space-y-10">
        {educationEntries.map(({ entry, kind }) => (
          <li><article aria-labelledby={`${entry.id}-title`} data-timeline-id={entry.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass(kind)}`}><CareerJourneyIcon kind={kind} /></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">{entry.organization}</p><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">{entry.period}</p></div><h4 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${entry.id}-title`}>{entry.role}</h4><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{entry.summary}</p></div></div></article></li>
        ))}
      </ol>
      <section class="mt-14" aria-labelledby="study-abroad-title">
        <div class="border-b-2 border-indigo-200 pb-4 dark:border-indigo-900">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">International study</p>
          <h4 class="mt-2 text-xl font-bold text-slate-950 dark:text-white" id="study-abroad-title">Study abroad</h4>
        </div>
        <ol class="mt-8 space-y-10">
          {studyAbroadEntries.map(({ entry, kind }) => (
            <li><article aria-labelledby={`${entry.id}-title`} data-timeline-id={entry.id}><div class="flex items-start gap-4"><span class={`grid h-16 w-16 shrink-0 place-items-center rounded-full border border-current/20 bg-current/5 p-2 ${colorClass(kind)}`}><CareerJourneyIcon kind={kind} /></span><div class="min-w-0 flex-1"><p class="text-sm font-bold uppercase tracking-[0.14em] text-indigo-700 dark:text-indigo-300">{entry.organization}</p>{entry.id === 'tomsk-study-abroad' ? <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><h5 class="text-xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${entry.id}-title`}>{entry.role}</h5><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">{entry.period}</p></div> : <><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><span></span><p class="font-mono text-sm font-semibold text-slate-600 dark:text-slate-300">{entry.period}</p></div><h5 class="mt-1 text-xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${entry.id}-title`}>{entry.role}</h5></>}<p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{entry.summary}</p></div></div></article></li>
          ))}
        </ol>
      </section>
    </section>
  </div>
</section>
