---
import { experience } from '../data';
import type { TimelineEntry } from '../data/schema';

const entries = [...experience]
  .sort((left, right) => right.startDate.localeCompare(left.startDate)) as TimelineEntry[];

const displayType = (entry: TimelineEntry): string => {
  if (entry.type === 'sabbatical') return 'Sabbatical';
  if (entry.type === 'upskilling') return 'Professional development';
  if (entry.type === 'education') return 'Education';
  if (entry.organization.includes('Fraunhofer')) return 'Research';
  if (entry.role.includes('Teaching')) return 'Teaching';
  return 'Industry';
};

const typeStyles: Record<string, string> = {
  Industry: 'border-blue-300 bg-blue-50 text-blue-900',
  Research: 'border-violet-300 bg-violet-50 text-violet-900',
  Education: 'border-emerald-300 bg-emerald-50 text-emerald-900',
  Teaching: 'border-cyan-300 bg-cyan-50 text-cyan-900',
  'Professional development': 'border-amber-300 bg-amber-50 text-amber-950',
  Sabbatical: 'border-rose-300 bg-rose-50 text-rose-900',
};
---

<section
  class="mx-auto max-w-5xl px-6 py-16 sm:py-24"
  id="experience"
  aria-labelledby="experience-title"
>
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700">Experience</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl" id="experience-title">
      Engineering, research, and education
    </h2>
    <p class="mt-4 text-lg leading-8 text-slate-700">
      A chronological record of industrial AI delivery, video-coding research, and mathematical training.
    </p>
  </div>

  <ol class="mt-10 space-y-6">
    {entries.map((entry) => {
      const label = displayType(entry);
      const hasDetails = entry.keyHighlights.length > 0 || (entry.techStack?.length ?? 0) > 0;

      return (
        <li class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" data-timeline-id={entry.id}>
          <article aria-labelledby={`${entry.id}-title`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-wide ${typeStyles[label]}`}>
                {label === 'Sabbatical' && <span aria-hidden="true">🌍</span>}
                {label}
              </span>
              <p class="font-mono text-sm font-semibold text-slate-600">{entry.period}</p>
            </div>

            <h3 class="mt-4 text-xl font-bold text-slate-950" id={`${entry.id}-title`}>
              {entry.role}
            </h3>
            <p class="mt-1 font-semibold text-slate-600">{entry.organization}</p>
            <p class="mt-4 max-w-3xl leading-7 text-slate-700">{entry.summary}</p>

            {hasDetails && (
              <details class="group mt-5 border-t border-slate-200 pt-4">
                <summary class="cursor-pointer font-semibold text-indigo-700 outline-offset-4 focus-visible:outline-2 focus-visible:outline-indigo-700">
                  Technical details
                </summary>
                <div class="mt-4 space-y-4 text-slate-700">
                  {entry.keyHighlights.length > 0 && (
                    <ul class="list-disc space-y-2 pl-5">
                      {entry.keyHighlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  )}
                  {(entry.techStack?.length ?? 0) > 0 && (
                    <ul class="flex flex-wrap gap-2" aria-label={`Technologies used for ${entry.role}`}>
                      {entry.techStack?.map((technology) => (
                        <li class="rounded-md bg-slate-100 px-2.5 py-1 text-sm font-medium text-slate-700">
                          {technology}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            )}
          </article>
        </li>
      );
    })}
  </ol>
</section>
