---
const year = new Date().getFullYear();
const githubUrl = 'https://github.com/JohannesErfurt';
const linkedInUrl = 'https://www.linkedin.com/in/johanneserfurt';
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} Johannes Erfurt</p>
    <nav aria-label="Social links">
      <ul class="flex gap-5 font-medium">
        <li><a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href={githubUrl}>GitHub</a></li>
        <li><a class="outline-offset-4 hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-indigo-700" href={linkedInUrl}>LinkedIn</a></li>
      </ul>
    </nav>
  </div>
</footer>
