---
interface Props {
  kind: 'mathematics' | 'phd' | 'hhi' | 'industry' | 'projects' | 'durham' | 'tomsk' | 'upskilling' | 'travel';
}

const { kind } = Astro.props;
const labels = {
  mathematics: 'Mathematics', phd: 'Doctoral research', hhi: 'Fraunhofer HHI research',
  industry: 'Industrial AI at Scansonic MI', projects: 'Private AI projects',
  durham: 'Study abroad at Durham University', tomsk: 'Study abroad at Tomsk Polytechnic University',
  upskilling: 'Further education and project phase', travel: 'World travel and parental leave',
} as const;
---

<svg viewBox="0 0 96 96" role="img" aria-label={labels[kind]} class="h-full w-full" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4">
  {kind === 'mathematics' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><circle cx="48" cy="48" r="34" /><path d="M62 29H36l19 19-19 19h26" /></>}
  {kind === 'phd' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="m16 39 32-17 32 17-32 17-32-17Z" /><path d="M27 47v15c9 8 33 8 42 0V47M77 41v22" /><circle cx="77" cy="66" r="3" fill="currentColor" stroke="none" /></>}
  {kind === 'hhi' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M24 24h48v48H24z" /><path d="M30 34h36M30 42h28M30 50h20M30 58h12M30 66l36-32" /></>}
  {kind === 'industry' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M19 71V43l18 10V42l18 10V34l22 13v24H19Z" /><path d="M30 71V59h12v12M56 58h4M67 58h4M56 66h4M67 66h4M25 31c8-8 16-8 24 0M31 25c5-5 10-5 15 0" /></>}
  {kind === 'projects' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M38 25a14 14 0 0 1 20 3 14 14 0 0 1 17 16 14 14 0 0 1-6 23 14 14 0 0 1-22 5 14 14 0 0 1-22-5 14 14 0 0 1-5-22 14 14 0 0 1 18-20Z" /><path d="M48 31v34M35 40l13 8 13-8M35 57l13-9 13 9" /><circle cx="35" cy="40" r="2" fill="currentColor" stroke="none" /><circle cx="61" cy="40" r="2" fill="currentColor" stroke="none" /><circle cx="35" cy="57" r="2" fill="currentColor" stroke="none" /><circle cx="61" cy="57" r="2" fill="currentColor" stroke="none" /></>}
  {kind === 'durham' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M48 22 72 30v19c0 15-11 22-24 27-13-5-24-12-24-27V30l24-8Z" /><path d="M48 23v48M25 43h46M36 31l4 4m16-4-4 4m-16 18 4 4m16-4-4 4M19 61c5 10 14 15 25 17M19 61l2 8m-2-8 8 1" /></>}
  {kind === 'tomsk' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M22 69h52M24 69V44h13v25M42 69V29h12v40M59 69V44h13v25M22 37h52M29 25h38M48 25v12M18 50c4-12 13-19 25-21M18 50l2-8m-2 8 8-1" /></>}
  {kind === 'upskilling' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><path d="M23 30h35a8 8 0 0 1 8 8v30H31a8 8 0 0 0-8-8V30Z" /><path d="M31 60V38a8 8 0 0 1 8-8h35v30M40 40h18M40 49h12M67 24v12M61 30h12" /></>}
  {kind === 'travel' && <><circle cx="48" cy="48" r="40" fill="currentColor" opacity="0.12" stroke="none" /><circle cx="45" cy="49" r="24" /><path d="M21 49h48M45 25c9 8 9 40 0 48M45 25c-9 8-9 40 0 48M24 64h42" /><path d="m57 29 16 5-13 6-7 13-5-16 9-8Z" /></>}
</svg>
