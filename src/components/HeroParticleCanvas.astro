<canvas
  class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full md:block"
  data-hero-particles
  aria-hidden="true"
></canvas>

<script>
  type Point = { x: number; y: number };
  type Particle = Point & {
    targetX: number;
    targetY: number;
    velocityX: number;
    velocityY: number;
    radius: number;
    phase: number;
  };

  type Target = { value: 'network' | 'vision' | 'music' | 'agents' };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-particles]');
  const hero = canvas?.closest<HTMLElement>('#hero');

  if (canvas && hero) {
    const context = canvas.getContext('2d');
    const maskCanvas = document.createElement('canvas');
    const maskContext = maskCanvas.getContext('2d', { willReadFrequently: true });

    if (context && maskContext) {
      const targets: Target[] = [
        { value: 'network' },
        { value: 'vision' },
        { value: 'music' },
        { value: 'agents' },
      ];
      // A long phase leaves a deliberate pause once the particles have settled.
      const phaseDuration = 12000;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktopLayout = window.matchMedia('(min-width: 768px)');
      const particles: Particle[] = [];
      let width = 0;
      let height = 0;
      let targetIndex = 0;
      let targetChangedAt = 0;
      let frameId = 0;
      let isVisible = true;
      let lastFrameAt = 0;

      const drawCircle = (x: number, y: number, radius: number) => {
        maskContext.beginPath();
        maskContext.arc(x, y, radius, 0, Math.PI * 2);
        maskContext.fill();
      };

      const drawLine = (from: Point, to: Point) => {
        maskContext.beginPath();
        maskContext.moveTo(from.x, from.y);
        maskContext.lineTo(to.x, to.y);
        maskContext.stroke();
      };

      const drawRoundedRect = (x: number, y: number, rectWidth: number, rectHeight: number, radius: number) => {
        const corner = Math.min(radius, rectWidth / 2, rectHeight / 2);
        maskContext.beginPath();
        maskContext.moveTo(x + corner, y);
        maskContext.lineTo(x + rectWidth - corner, y);
        maskContext.quadraticCurveTo(x + rectWidth, y, x + rectWidth, y + corner);
        maskContext.lineTo(x + rectWidth, y + rectHeight - corner);
        maskContext.quadraticCurveTo(x + rectWidth, y + rectHeight, x + rectWidth - corner, y + rectHeight);
        maskContext.lineTo(x + corner, y + rectHeight);
        maskContext.quadraticCurveTo(x, y + rectHeight, x, y + rectHeight - corner);
        maskContext.lineTo(x, y + corner);
        maskContext.quadraticCurveTo(x, y, x + corner, y);
        maskContext.closePath();
        maskContext.stroke();
      };

      const drawShape = (shape: Target['value']) => {
        const centerX = width * 0.85;
        const centerY = height * 0.5;
        const scale = Math.min(width * 0.15, height * 0.32);

        maskContext.fillStyle = '#fff';
        maskContext.strokeStyle = '#fff';
        maskContext.lineWidth = Math.max(5, scale * 0.045);
        maskContext.lineCap = 'round';
        maskContext.lineJoin = 'round';

        if (shape === 'network') {
          const nodes = [
            { x: centerX - scale * 0.9, y: centerY - scale * 0.35 },
            { x: centerX - scale * 0.9, y: centerY + scale * 0.56 },
            { x: centerX - scale * 0.1, y: centerY - scale * 0.86 },
            { x: centerX - scale * 0.05, y: centerY },
            { x: centerX - scale * 0.08, y: centerY + scale * 0.85 },
            { x: centerX + scale * 0.96, y: centerY + scale * 0.1 },
          ];
          const links: Array<readonly [number, number]> = [[0, 2], [0, 3], [0, 4], [1, 2], [1, 3], [1, 4], [2, 5], [3, 5], [4, 5]];
          links.forEach(([from, to]) => drawLine(nodes[from]!, nodes[to]!));
          const neuronDots = [
            [-0.11, -0.1], [0.08, -0.12], [0.13, 0.04], [-0.04, 0.12],
            [-0.15, 0.06], [0.02, -0.01], [0.1, 0.14], [-0.08, -0.18],
          ] as const;
          nodes.forEach((node, index) => {
            maskContext.beginPath();
            maskContext.arc(node.x, node.y, scale * 0.27, 0, Math.PI * 2);
            maskContext.stroke();
            neuronDots.forEach(([offsetX, offsetY], dotIndex) => {
              const multiplier = 1 + ((index + dotIndex) % 3) * 0.18;
              drawCircle(node.x + scale * offsetX * multiplier, node.y + scale * offsetY * multiplier, scale * 0.035);
            });
          });
          [
            { x: centerX - scale * 0.56, y: centerY - scale * 0.65 },
            { x: centerX - scale * 0.42, y: centerY + scale * 0.25 },
            { x: centerX + scale * 0.4, y: centerY - scale * 0.55 },
            { x: centerX + scale * 0.5, y: centerY + scale * 0.45 },
          ].forEach((particle) => drawCircle(particle.x, particle.y, scale * 0.035));
        }

        if (shape === 'vision') {
          maskContext.beginPath();
          maskContext.ellipse(centerX, centerY, scale * 1.1, scale * 0.62, 0, 0, Math.PI * 2);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.arc(centerX, centerY, scale * 0.32, 0, Math.PI * 2);
          maskContext.stroke();
          drawCircle(centerX, centerY, scale * 0.14);
          maskContext.globalCompositeOperation = 'destination-out';
          drawCircle(centerX + scale * 0.05, centerY - scale * 0.08, scale * 0.05);
          maskContext.globalCompositeOperation = 'source-over';
        }

        if (shape === 'music') {
          const leftNote = { x: centerX - scale * 0.48, y: centerY + scale * 0.48 };
          const rightNote = { x: centerX + scale * 0.42, y: centerY + scale * 0.28 };
          drawCircle(leftNote.x, leftNote.y, scale * 0.19);
          drawCircle(rightNote.x, rightNote.y, scale * 0.19);
          drawLine({ x: leftNote.x + scale * 0.13, y: leftNote.y }, { x: leftNote.x + scale * 0.13, y: centerY - scale * 0.68 });
          drawLine({ x: rightNote.x + scale * 0.13, y: rightNote.y }, { x: rightNote.x + scale * 0.13, y: centerY - scale * 0.82 });
          drawLine({ x: leftNote.x + scale * 0.13, y: centerY - scale * 0.68 }, { x: rightNote.x + scale * 0.13, y: centerY - scale * 0.82 });
          maskContext.beginPath();
          maskContext.arc(centerX - scale * 0.88, centerY, scale * 0.23, -Math.PI / 2, Math.PI / 2);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.arc(centerX + scale * 0.95, centerY, scale * 0.23, Math.PI / 2, Math.PI * 1.5);
          maskContext.stroke();
        }

        if (shape === 'agents') {
          const orbit = scale * 1.05;
          const toolPoints = [
            { x: centerX, y: centerY - orbit },
            { x: centerX + orbit * 0.92, y: centerY - orbit * 0.42 },
            { x: centerX + orbit * 0.92, y: centerY + orbit * 0.45 },
            { x: centerX, y: centerY + orbit },
            { x: centerX - orbit * 0.92, y: centerY + orbit * 0.45 },
            { x: centerX - orbit * 0.92, y: centerY - orbit * 0.42 },
          ];

          maskContext.setLineDash([scale * 0.07, scale * 0.075]);
          maskContext.beginPath();
          maskContext.ellipse(centerX, centerY, orbit * 1.08, orbit * 0.92, 0, 0, Math.PI * 2);
          maskContext.stroke();
          maskContext.setLineDash([]);
          toolPoints.forEach((point) => drawLine({ x: centerX, y: centerY }, point));

          const robotWidth = scale * 1.08;
          const robotHeight = scale * 0.86;
          const robotLeft = centerX - robotWidth / 2;
          const robotTop = centerY - robotHeight / 2;
          drawRoundedRect(robotLeft, robotTop, robotWidth, robotHeight, scale * 0.22);
          drawRoundedRect(robotLeft + scale * 0.16, robotTop + scale * 0.17, robotWidth - scale * 0.32, robotHeight - scale * 0.34, scale * 0.16);
          drawCircle(centerX - scale * 0.18, centerY, scale * 0.07);
          drawCircle(centerX + scale * 0.18, centerY, scale * 0.07);
          drawLine({ x: centerX, y: robotTop }, { x: centerX, y: robotTop - scale * 0.2 });
          drawCircle(centerX, robotTop - scale * 0.25, scale * 0.07);
          drawCircle(robotLeft - scale * 0.08, centerY, scale * 0.12);
          drawCircle(robotLeft + robotWidth + scale * 0.08, centerY, scale * 0.12);

          const speech = toolPoints[0]!;
          drawRoundedRect(speech.x - scale * 0.38, speech.y - scale * 0.22, scale * 0.76, scale * 0.42, scale * 0.12);
          drawLine({ x: speech.x - scale * 0.1, y: speech.y + scale * 0.2 }, { x: speech.x - scale * 0.18, y: speech.y + scale * 0.32 });
          [-0.16, 0, 0.16].forEach((offset) => drawCircle(speech.x + scale * offset, speech.y, scale * 0.045));

          const brain = toolPoints[1]!;
          drawCircle(brain.x - scale * 0.15, brain.y, scale * 0.2);
          drawCircle(brain.x + scale * 0.15, brain.y, scale * 0.2);
          drawLine({ x: brain.x, y: brain.y - scale * 0.2 }, { x: brain.x, y: brain.y + scale * 0.2 });

          const document = toolPoints[2]!;
          drawRoundedRect(document.x - scale * 0.28, document.y - scale * 0.27, scale * 0.56, scale * 0.54, scale * 0.07);
          [-0.11, 0.04, 0.18].forEach((offset) => drawLine(
            { x: document.x - scale * 0.15, y: document.y + scale * offset },
            { x: document.x + scale * 0.15, y: document.y + scale * offset },
          ));

          const globe = toolPoints[3]!;
          maskContext.beginPath();
          maskContext.arc(globe.x, globe.y, scale * 0.28, 0, Math.PI * 2);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.ellipse(globe.x, globe.y, scale * 0.12, scale * 0.28, 0, 0, Math.PI * 2);
          maskContext.stroke();
          drawLine({ x: globe.x - scale * 0.28, y: globe.y }, { x: globe.x + scale * 0.28, y: globe.y });

          const search = toolPoints[4]!;
          maskContext.beginPath();
          maskContext.arc(search.x - scale * 0.06, search.y - scale * 0.05, scale * 0.2, 0, Math.PI * 2);
          maskContext.stroke();
          drawLine({ x: search.x + scale * 0.08, y: search.y + scale * 0.1 }, { x: search.x + scale * 0.28, y: search.y + scale * 0.3 });

          const calendar = toolPoints[5]!;
          drawRoundedRect(calendar.x - scale * 0.3, calendar.y - scale * 0.25, scale * 0.6, scale * 0.5, scale * 0.07);
          drawLine({ x: calendar.x - scale * 0.3, y: calendar.y - scale * 0.08 }, { x: calendar.x + scale * 0.3, y: calendar.y - scale * 0.08 });
          [-0.13, 0.13].forEach((offset) => drawCircle(calendar.x + scale * offset, calendar.y - scale * 0.32, scale * 0.05));
        }

      };

      const targetPoints = (target: Target): Point[] => {
        maskContext.clearRect(0, 0, width, height);
        drawShape(target.value);

        const imageData = maskContext.getImageData(0, 0, width, height).data;
        const points: Point[] = [];
        const sampleStep = Math.max(4, Math.round(width / 260));
        for (let y = 0; y < height; y += sampleStep) {
          for (let x = Math.floor(width * 0.64); x < width * 0.995; x += sampleStep) {
            if ((imageData[(y * width + x) * 4 + 3] ?? 0) > 120) points.push({ x, y });
          }
        }
        return points;
      };

      const assignTarget = (target: Target, reset = false) => {
        const points = targetPoints(target);
        if (points.length === 0) return;
        const particleCount = Math.min(440, Math.max(300, Math.floor((width * height) / 1800)));

        while (particles.length < particleCount) {
          particles.push({
            x: width * (0.68 + Math.random() * 0.28),
            y: height * (0.2 + Math.random() * 0.6),
            targetX: width * 0.85,
            targetY: height * 0.5,
            velocityX: 0,
            velocityY: 0,
            radius: 1.7 + Math.random() * 1.55,
            phase: Math.random() * Math.PI * 2,
          });
        }
        particles.length = particleCount;

        particles.forEach((particle, index) => {
          const point = points[Math.floor((index * points.length) / particleCount) % points.length] ?? points[0]!;
          particle.targetX = point.x;
          particle.targetY = point.y;
          if (reset) {
            particle.x = point.x;
            particle.y = point.y;
            particle.velocityX = 0;
            particle.velocityY = 0;
          }
        });
      };

      const renderStatic = () => {
        context.clearRect(0, 0, width, height);
        assignTarget(targets[0]!, true);
        particles.forEach((particle) => {
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = 'rgba(224, 242, 254, 0.82)';
          context.fill();
        });
      };

      const animate = (time: number) => {
        if (!desktopLayout.matches || reducedMotion.matches || !isVisible || document.hidden) {
          frameId = 0;
          return;
        }

        if (time - lastFrameAt < 1000 / 45) {
          frameId = window.requestAnimationFrame(animate);
          return;
        }
        lastFrameAt = time;

        if (time - targetChangedAt > phaseDuration) {
          targetIndex = (targetIndex + 1) % targets.length;
          assignTarget(targets[targetIndex] ?? targets[0]!);
          targetChangedAt = time;
        }

        context.clearRect(0, 0, width, height);
        particles.forEach((particle) => {
          particle.velocityX = particle.velocityX * 0.86 + (particle.targetX - particle.x) * 0.014;
          particle.velocityY = particle.velocityY * 0.86 + (particle.targetY - particle.y) * 0.014;
          particle.x += particle.velocityX;
          particle.y += particle.velocityY;
          const shimmer = 0.78 + Math.sin(time * 0.002 + particle.phase) * 0.16;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = `rgba(224, 242, 254, ${shimmer})`;
          context.fill();
        });
        frameId = window.requestAnimationFrame(animate);
      };

      const start = () => {
        if (frameId || !desktopLayout.matches || reducedMotion.matches || !isVisible || document.hidden) return;
        targetChangedAt = performance.now();
        frameId = window.requestAnimationFrame(animate);
      };

      const resize = () => {
        const bounds = hero.getBoundingClientRect();
        const nextWidth = Math.max(1, Math.round(bounds.width));
        const nextHeight = Math.max(1, Math.round(bounds.height));
        if (nextWidth === width && nextHeight === height && particles.length > 0) return;
        width = nextWidth;
        height = nextHeight;
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        maskCanvas.width = width;
        maskCanvas.height = height;
        assignTarget(targets[targetIndex] ?? targets[0]!, reducedMotion.matches || particles.length > 0);
        reducedMotion.matches ? renderStatic() : start();
      };

      const stop = () => {
        if (frameId) window.cancelAnimationFrame(frameId);
        frameId = 0;
      };

      const visibilityObserver = new IntersectionObserver(([entry]) => {
        if (!entry) return;
        isVisible = entry.isIntersecting;
        isVisible ? start() : stop();
      }, { threshold: 0.05 });

      const resizeObserver = new ResizeObserver(resize);
      let isInitialized = false;

      const handleMotionChange = () => {
        if (!isInitialized) return;
        stop();
        reducedMotion.matches ? renderStatic() : start();
      };

      const handleDocumentVisibility = () => document.hidden ? stop() : start();

      const enable = () => {
        if (isInitialized || !desktopLayout.matches) return;
        isInitialized = true;
        resizeObserver.observe(hero);
        visibilityObserver.observe(hero);
        resize();
      };

      const disable = () => {
        if (!isInitialized) return;
        isInitialized = false;
        stop();
        resizeObserver.unobserve(hero);
        visibilityObserver.unobserve(hero);
        particles.length = 0;
        context.clearRect(0, 0, width, height);
        width = 0;
        height = 0;
      };

      const handleLayoutChange = () => desktopLayout.matches ? enable() : disable();

      reducedMotion.addEventListener('change', handleMotionChange);
      desktopLayout.addEventListener('change', handleLayoutChange);
      document.addEventListener('visibilitychange', handleDocumentVisibility);
      enable();
    }
  }
</script>
