<canvas
  class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full md:block"
  data-hero-particles
  aria-hidden="true"
></canvas>

<script>
  type Point = { x: number; y: number };
  type Particle = Point & {
    targetX: number;
    targetY: number;
    velocityX: number;
    velocityY: number;
    radius: number;
    phase: number;
  };

  type Target = { value: 'network' | 'vision' | 'music' | 'agents' | 'storybook' };

  const desktopLayout = window.matchMedia('(min-width: 768px)');
  if (!desktopLayout.matches) {
    // Decorative animation only; skip script work on mobile Lighthouse runs.
  } else {
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-particles]');
  const hero = canvas?.closest<HTMLElement>('#hero');

  if (canvas && hero) {
    const context = canvas.getContext('2d');
    const maskCanvas = document.createElement('canvas');
    const maskContext = maskCanvas.getContext('2d', { willReadFrequently: true });

    if (context && maskContext) {
      const targets: Target[] = [
        { value: 'network' },
        { value: 'vision' },
        { value: 'music' },
        { value: 'agents' },
        { value: 'storybook' },
      ];
      // A long phase leaves a deliberate pause once the particles have settled.
      const phaseDuration = 12000;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const particles: Particle[] = [];
      let width = 0;
      let height = 0;
      let targetIndex = 0;
      let targetChangedAt = 0;
      let frameId = 0;
      let isVisible = true;
      let lastFrameAt = 0;

      const drawCircle = (x: number, y: number, radius: number) => {
        maskContext.beginPath();
        maskContext.arc(x, y, radius, 0, Math.PI * 2);
        maskContext.fill();
      };

      const drawLine = (from: Point, to: Point) => {
        maskContext.beginPath();
        maskContext.moveTo(from.x, from.y);
        maskContext.lineTo(to.x, to.y);
        maskContext.stroke();
      };

      const drawRoundedRect = (x: number, y: number, rectWidth: number, rectHeight: number, radius: number) => {
        const corner = Math.min(radius, rectWidth / 2, rectHeight / 2);
        maskContext.beginPath();
        maskContext.moveTo(x + corner, y);
        maskContext.lineTo(x + rectWidth - corner, y);
        maskContext.quadraticCurveTo(x + rectWidth, y, x + rectWidth, y + corner);
        maskContext.lineTo(x + rectWidth, y + rectHeight - corner);
        maskContext.quadraticCurveTo(x + rectWidth, y + rectHeight, x + rectWidth - corner, y + rectHeight);
        maskContext.lineTo(x + corner, y + rectHeight);
        maskContext.quadraticCurveTo(x, y + rectHeight, x, y + rectHeight - corner);
        maskContext.lineTo(x, y + corner);
        maskContext.quadraticCurveTo(x, y, x + corner, y);
        maskContext.closePath();
        maskContext.stroke();
      };

      const drawShape = (shape: Target['value']) => {
        const centerX = width * 0.85;
        const centerY = height * 0.5;
        const scale = Math.min(width * 0.15, height * 0.32);

        maskContext.fillStyle = '#fff';
        maskContext.strokeStyle = '#fff';
        maskContext.lineWidth = Math.max(5, scale * 0.045);
        maskContext.lineCap = 'round';
        maskContext.lineJoin = 'round';

        if (shape === 'network') {
          // A classic three-layer neural network: clear neuron circles and
          // dense connections remain recognisable after the particles settle.
          const inputNodes = [-0.62, 0, 0.62].map((offset) => ({ x: centerX - scale * 0.9, y: centerY + scale * offset }));
          const hiddenNodes = [-0.78, -0.26, 0.26, 0.78].map((offset) => ({ x: centerX, y: centerY + scale * offset }));
          const outputNodes = [-0.38, 0.38].map((offset) => ({ x: centerX + scale * 0.9, y: centerY + scale * offset }));
          inputNodes.forEach((input) => hiddenNodes.forEach((hidden) => drawLine(input, hidden)));
          hiddenNodes.forEach((hidden) => outputNodes.forEach((output) => drawLine(hidden, output)));
          [...inputNodes, ...hiddenNodes, ...outputNodes].forEach((node) => {
            maskContext.beginPath();
            maskContext.arc(node.x, node.y, scale * 0.19, 0, Math.PI * 2);
            maskContext.stroke();
            drawCircle(node.x, node.y, scale * 0.07);
          });
        }

        if (shape === 'vision') {
          maskContext.beginPath();
          maskContext.moveTo(centerX - scale * 1.12, centerY);
          maskContext.quadraticCurveTo(centerX, centerY - scale * 0.92, centerX + scale * 1.12, centerY);
          maskContext.quadraticCurveTo(centerX, centerY + scale * 0.92, centerX - scale * 1.12, centerY);
          maskContext.closePath();
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.arc(centerX, centerY, scale * 0.55, 0, Math.PI * 2);
          maskContext.stroke();
          drawCircle(centerX, centerY, scale * 0.14);
          maskContext.beginPath();
          maskContext.arc(centerX, centerY, scale * 0.3, 0, Math.PI * 2);
          maskContext.stroke();

          const nodes = [
            { x: centerX, y: centerY - scale * 1.2, anchor: { x: centerX, y: centerY - scale * 0.66 } },
            { x: centerX + scale * 0.86, y: centerY - scale * 0.9, anchor: { x: centerX + scale * 0.56, y: centerY - scale * 0.52 } },
            { x: centerX + scale * 1.42, y: centerY, anchor: { x: centerX + scale * 1.12, y: centerY } },
            { x: centerX + scale * 0.83, y: centerY + scale * 0.96, anchor: { x: centerX + scale * 0.54, y: centerY + scale * 0.55 } },
            { x: centerX, y: centerY + scale * 1.28, anchor: { x: centerX, y: centerY + scale * 0.68 } },
            { x: centerX - scale * 0.83, y: centerY + scale * 0.96, anchor: { x: centerX - scale * 0.54, y: centerY + scale * 0.55 } },
            { x: centerX - scale * 1.42, y: centerY, anchor: { x: centerX - scale * 1.12, y: centerY } },
            { x: centerX - scale * 0.86, y: centerY - scale * 0.9, anchor: { x: centerX - scale * 0.56, y: centerY - scale * 0.52 } },
          ];
          nodes.forEach((node) => {
            drawLine({ x: node.x, y: node.y }, node.anchor);
            maskContext.beginPath();
            maskContext.arc(node.x, node.y, scale * 0.16, 0, Math.PI * 2);
            maskContext.stroke();
          });
        }

        if (shape === 'music') {
          const deckSize = scale * 1.72;
          const deckLeft = centerX - deckSize / 2;
          const deckTop = centerY - deckSize / 2;
          drawRoundedRect(deckLeft, deckTop, deckSize, deckSize, scale * 0.12);

          maskContext.beginPath();
          maskContext.arc(centerX, centerY + scale * 0.02, scale * 0.58, 0, Math.PI * 2);
          maskContext.stroke();

          const noteBase = { x: centerX - scale * 0.18, y: centerY + scale * 0.37 };
          drawCircle(noteBase.x, noteBase.y, scale * 0.13);
          drawCircle(centerX + scale * 0.28, centerY + scale * 0.18, scale * 0.13);
          drawLine({ x: noteBase.x + scale * 0.1, y: noteBase.y }, { x: noteBase.x + scale * 0.1, y: centerY - scale * 0.36 });
          drawLine({ x: centerX + scale * 0.38, y: centerY + scale * 0.18 }, { x: centerX + scale * 0.38, y: centerY - scale * 0.53 });
          drawLine({ x: noteBase.x + scale * 0.1, y: centerY - scale * 0.36 }, { x: centerX + scale * 0.38, y: centerY - scale * 0.53 });
          drawLine({ x: noteBase.x + scale * 0.1, y: centerY - scale * 0.15 }, { x: centerX + scale * 0.38, y: centerY - scale * 0.28 });

          const knobs = [
            { x: deckLeft + scale * 0.2, y: deckTop + scale * 0.38 },
            { x: deckLeft + scale * 0.2, y: centerY - scale * 0.18 },
            { x: deckLeft + scale * 0.2, y: centerY + scale * 0.45 },
            { x: deckLeft + deckSize - scale * 0.2, y: deckTop + scale * 0.35 },
            { x: deckLeft + deckSize - scale * 0.2, y: centerY + scale * 0.38 },
          ];
          knobs.forEach((knob) => {
            maskContext.beginPath();
            maskContext.arc(knob.x, knob.y, scale * 0.1, 0, Math.PI * 2);
            maskContext.stroke();
          });

          const faders = [-0.38, 0, 0.38];
          faders.forEach((offset, index) => {
            const x = centerX + scale * offset;
            const top = deckTop + deckSize - scale * 0.35;
            drawLine({ x, y: top }, { x, y: deckTop + deckSize - scale * 0.08 });
            drawCircle(x, top + scale * (0.08 + index * 0.08), scale * 0.07);
          });
        }

        if (shape === 'agents') {
          const robotWidth = scale * 1.34;
          const robotHeight = scale * 1.04;
          const robotLeft = centerX - robotWidth / 2;
          const robotTop = centerY - robotHeight / 2;
          drawRoundedRect(robotLeft, robotTop, robotWidth, robotHeight, scale * 0.26);
          drawRoundedRect(robotLeft + scale * 0.17, robotTop + scale * 0.18, robotWidth - scale * 0.34, robotHeight - scale * 0.36, scale * 0.18);
          drawCircle(centerX - scale * 0.22, centerY, scale * 0.085);
          drawCircle(centerX + scale * 0.22, centerY, scale * 0.085);
          drawLine({ x: centerX, y: robotTop }, { x: centerX, y: robotTop - scale * 0.22 });
          drawCircle(centerX, robotTop - scale * 0.29, scale * 0.085);
          drawCircle(robotLeft - scale * 0.1, centerY, scale * 0.14);
          drawCircle(robotLeft + robotWidth + scale * 0.1, centerY, scale * 0.14);

          const speech = { x: centerX, y: centerY - scale * 1.13 };
          const brain = { x: centerX + scale * 1.12, y: centerY - scale * 0.25 };
          const document = { x: centerX + scale * 0.93, y: centerY + scale * 0.86 };
          const globe = { x: centerX - scale * 0.95, y: centerY + scale * 0.86 };
          [
            { from: { x: centerX, y: robotTop - scale * 0.22 }, to: speech },
            { from: { x: robotLeft + robotWidth, y: centerY - scale * 0.15 }, to: brain },
            { from: { x: robotLeft + robotWidth * 0.75, y: robotTop + robotHeight }, to: document },
            { from: { x: robotLeft + robotWidth * 0.25, y: robotTop + robotHeight }, to: globe },
          ].forEach((connection) => drawLine(connection.from, connection.to));

          drawRoundedRect(speech.x - scale * 0.34, speech.y - scale * 0.2, scale * 0.68, scale * 0.4, scale * 0.12);
          drawLine({ x: speech.x - scale * 0.1, y: speech.y + scale * 0.2 }, { x: speech.x - scale * 0.18, y: speech.y + scale * 0.31 });
          [-0.14, 0, 0.14].forEach((offset) => drawCircle(speech.x + scale * offset, speech.y, scale * 0.05));

          drawCircle(brain.x - scale * 0.15, brain.y, scale * 0.21);
          drawCircle(brain.x + scale * 0.15, brain.y, scale * 0.21);
          drawLine({ x: brain.x, y: brain.y - scale * 0.2 }, { x: brain.x, y: brain.y + scale * 0.2 });

          drawRoundedRect(document.x - scale * 0.28, document.y - scale * 0.28, scale * 0.56, scale * 0.56, scale * 0.07);
          [-0.1, 0.08].forEach((offset) => drawLine({ x: document.x - scale * 0.15, y: document.y + scale * offset }, { x: document.x + scale * 0.15, y: document.y + scale * offset }));

          maskContext.beginPath();
          maskContext.arc(globe.x, globe.y, scale * 0.28, 0, Math.PI * 2);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.ellipse(globe.x, globe.y, scale * 0.12, scale * 0.28, 0, 0, Math.PI * 2);
          maskContext.stroke();
          drawLine({ x: globe.x - scale * 0.28, y: globe.y }, { x: globe.x + scale * 0.28, y: globe.y });
        }

        if (shape === 'storybook') {
          const bookLeft = centerX - scale * 1.12;
          const bookRight = centerX + scale * 1.12;
          const bookTop = centerY - scale * 0.32;
          const bookBottom = centerY + scale * 0.9;
          const spineBottom = bookBottom + scale * 0.22;

          // Open-book outline and curved page edges.
          drawLine({ x: bookLeft, y: bookTop }, { x: centerX, y: centerY + scale * 0.22 });
          drawLine({ x: centerX, y: centerY + scale * 0.22 }, { x: bookRight, y: bookTop });
          drawLine({ x: bookLeft, y: bookTop }, { x: bookLeft, y: bookBottom });
          drawLine({ x: bookRight, y: bookTop }, { x: bookRight, y: bookBottom });
          drawLine({ x: centerX, y: centerY + scale * 0.22 }, { x: centerX, y: spineBottom });
          maskContext.beginPath();
          maskContext.moveTo(bookLeft, bookBottom);
          maskContext.quadraticCurveTo(centerX - scale * 0.38, bookBottom - scale * 0.04, centerX, spineBottom);
          maskContext.quadraticCurveTo(centerX + scale * 0.38, bookBottom - scale * 0.04, bookRight, bookBottom);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.moveTo(bookLeft - scale * 0.1, bookBottom + scale * 0.12);
          maskContext.quadraticCurveTo(centerX - scale * 0.34, bookBottom + scale * 0.03, centerX, spineBottom + scale * 0.12);
          maskContext.quadraticCurveTo(centerX + scale * 0.34, bookBottom + scale * 0.03, bookRight + scale * 0.1, bookBottom + scale * 0.12);
          maskContext.stroke();

          // A large, full-body child on the left page makes the storybook
          // unmistakable even when rendered only as particles.
          const character = { x: centerX - scale * 0.55, y: centerY + scale * 0.3 };
          maskContext.beginPath();
          maskContext.arc(character.x, character.y, scale * 0.19, 0, Math.PI * 2);
          maskContext.stroke();
          drawCircle(character.x - scale * 0.065, character.y - scale * 0.025, scale * 0.027);
          drawCircle(character.x + scale * 0.065, character.y - scale * 0.025, scale * 0.027);
          maskContext.beginPath();
          maskContext.arc(character.x, character.y + scale * 0.035, scale * 0.075, 0.15 * Math.PI, 0.85 * Math.PI);
          maskContext.stroke();
          maskContext.beginPath();
          maskContext.arc(character.x, character.y - scale * 0.17, scale * 0.16, Math.PI, Math.PI * 2);
          maskContext.stroke();
          const shouldersY = character.y + scale * 0.22;
          drawLine({ x: character.x - scale * 0.2, y: shouldersY }, { x: character.x, y: character.y + scale * 0.34 });
          drawLine({ x: character.x, y: character.y + scale * 0.34 }, { x: character.x + scale * 0.2, y: shouldersY });
          drawLine({ x: character.x - scale * 0.14, y: shouldersY + scale * 0.04 }, { x: character.x - scale * 0.3, y: character.y + scale * 0.38 });
          drawLine({ x: character.x + scale * 0.14, y: shouldersY + scale * 0.04 }, { x: character.x + scale * 0.3, y: character.y + scale * 0.38 });
          drawLine({ x: character.x - scale * 0.07, y: character.y + scale * 0.34 }, { x: character.x - scale * 0.14, y: character.y + scale * 0.62 });
          drawLine({ x: character.x + scale * 0.07, y: character.y + scale * 0.34 }, { x: character.x + scale * 0.14, y: character.y + scale * 0.62 });

          // Story text lines on the right page.
          [-0.04, 0.18, 0.4, 0.62].forEach((offset, index) => drawLine(
            { x: centerX + scale * 0.35, y: centerY + scale * offset },
            { x: bookRight - scale * (index === 3 ? 0.44 : 0.2), y: centerY + scale * offset },
          ));

          // One star above the pages reinforces the story theme without
          // competing with the book or child figure.
          const star = { x: centerX + scale * 0.88, y: centerY - scale * 1.03 };
          const starPoints = Array.from({ length: 10 }, (_, index) => {
            const angle = -Math.PI / 2 + index * Math.PI / 5;
            const radius = index % 2 === 0 ? scale * 0.23 : scale * 0.1;
            return { x: star.x + Math.cos(angle) * radius, y: star.y + Math.sin(angle) * radius };
          });
          starPoints.forEach((point, index) => drawLine(point, starPoints[(index + 1) % starPoints.length]!));
          [{ x: centerX + scale * 0.18, y: centerY - scale * 1.4 }, { x: centerX - scale * 1.42, y: centerY - scale * 0.6 }].forEach((sparkle) => {
            drawLine({ x: sparkle.x - scale * 0.07, y: sparkle.y }, { x: sparkle.x + scale * 0.07, y: sparkle.y });
            drawLine({ x: sparkle.x, y: sparkle.y - scale * 0.07 }, { x: sparkle.x, y: sparkle.y + scale * 0.07 });
          });
        }

      };

      const targetPoints = (target: Target): Point[] => {
        maskContext.clearRect(0, 0, width, height);
        drawShape(target.value);

        const imageData = maskContext.getImageData(0, 0, width, height).data;
        const points: Point[] = [];
        const sampleStep = Math.max(4, Math.round(width / 260));
        for (let y = 0; y < height; y += sampleStep) {
          for (let x = Math.floor(width * 0.64); x < width * 0.995; x += sampleStep) {
            if ((imageData[(y * width + x) * 4 + 3] ?? 0) > 120) points.push({ x, y });
          }
        }
        return points;
      };

      const assignTarget = (target: Target, reset = false) => {
        const points = targetPoints(target);
        if (points.length === 0) return;
        const particleCount = Math.min(720, Math.max(500, Math.floor((width * height) / 900)));

        while (particles.length < particleCount) {
          particles.push({
            x: width * (0.68 + Math.random() * 0.28),
            y: height * (0.2 + Math.random() * 0.6),
            targetX: width * 0.85,
            targetY: height * 0.5,
            velocityX: 0,
            velocityY: 0,
            radius: 1.9 + Math.random() * 1.7,
            phase: Math.random() * Math.PI * 2,
          });
        }
        particles.length = particleCount;

        particles.forEach((particle, index) => {
          const point = points[Math.floor((index * points.length) / particleCount) % points.length] ?? points[0]!;
          particle.targetX = point.x;
          particle.targetY = point.y;
          if (reset) {
            particle.x = point.x;
            particle.y = point.y;
            particle.velocityX = 0;
            particle.velocityY = 0;
          }
        });
      };

      const renderStatic = () => {
        context.clearRect(0, 0, width, height);
        assignTarget(targets[0]!, true);
        particles.forEach((particle) => {
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = 'rgba(224, 242, 254, 0.82)';
          context.fill();
        });
      };

      const animate = (time: number) => {
        if (!desktopLayout.matches || reducedMotion.matches || !isVisible || document.hidden) {
          frameId = 0;
          return;
        }

        if (time - lastFrameAt < 1000 / 45) {
          frameId = window.requestAnimationFrame(animate);
          return;
        }
        lastFrameAt = time;

        if (time - targetChangedAt > phaseDuration) {
          targetIndex = (targetIndex + 1) % targets.length;
          assignTarget(targets[targetIndex] ?? targets[0]!);
          targetChangedAt = time;
        }

        context.clearRect(0, 0, width, height);
        particles.forEach((particle) => {
          particle.velocityX = particle.velocityX * 0.86 + (particle.targetX - particle.x) * 0.014;
          particle.velocityY = particle.velocityY * 0.86 + (particle.targetY - particle.y) * 0.014;
          particle.x += particle.velocityX;
          particle.y += particle.velocityY;
          const shimmer = 0.84 + Math.sin(time * 0.002 + particle.phase) * 0.12;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = `rgba(224, 242, 254, ${shimmer})`;
          context.fill();
        });
        frameId = window.requestAnimationFrame(animate);
      };

      const start = () => {
        if (frameId || !desktopLayout.matches || reducedMotion.matches || !isVisible || document.hidden) return;
        targetChangedAt = performance.now();
        frameId = window.requestAnimationFrame(animate);
      };

      const resize = () => {
        const bounds = hero.getBoundingClientRect();
        const nextWidth = Math.max(1, Math.round(bounds.width));
        const nextHeight = Math.max(1, Math.round(bounds.height));
        if (nextWidth === width && nextHeight === height && particles.length > 0) return;
        width = nextWidth;
        height = nextHeight;
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        maskCanvas.width = width;
        maskCanvas.height = height;
        assignTarget(targets[targetIndex] ?? targets[0]!, reducedMotion.matches || particles.length > 0);
        reducedMotion.matches ? renderStatic() : start();
      };

      const stop = () => {
        if (frameId) window.cancelAnimationFrame(frameId);
        frameId = 0;
      };

      const visibilityObserver = new IntersectionObserver(([entry]) => {
        if (!entry) return;
        isVisible = entry.isIntersecting;
        isVisible ? start() : stop();
      }, { threshold: 0.05 });

      const resizeObserver = new ResizeObserver(resize);
      let isInitialized = false;

      const handleMotionChange = () => {
        if (!isInitialized) return;
        stop();
        reducedMotion.matches ? renderStatic() : start();
      };

      const handleDocumentVisibility = () => document.hidden ? stop() : start();

      const enable = () => {
        if (isInitialized || !desktopLayout.matches) return;
        isInitialized = true;
        resizeObserver.observe(hero);
        visibilityObserver.observe(hero);
        resize();
      };

      const disable = () => {
        if (!isInitialized) return;
        isInitialized = false;
        stop();
        resizeObserver.unobserve(hero);
        visibilityObserver.unobserve(hero);
        particles.length = 0;
        context.clearRect(0, 0, width, height);
        width = 0;
        height = 0;
      };

      const handleLayoutChange = () => desktopLayout.matches ? enable() : disable();

      const boot = () => {
        reducedMotion.addEventListener('change', handleMotionChange);
        desktopLayout.addEventListener('change', handleLayoutChange);
        document.addEventListener('visibilitychange', handleDocumentVisibility);
        enable();
      };

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(boot, { timeout: 2000 });
      } else {
        globalThis.setTimeout(boot, 1);
      }
    }
  }
  }
</script>
