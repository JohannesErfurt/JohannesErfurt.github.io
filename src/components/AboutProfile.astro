---
import { aboutHighlights, aboutIntro, hobbies } from '../data/about';
import type { AboutIcon, Hobby } from '../data/about';

const highlightIconPaths: Record<AboutIcon, string> = {
  education: 'M12 3 2 8l10 5 8-4v6h2V8L12 3Zm-6 9v4.5c0 1.9 2.7 3.5 6 3.5s6-1.6 6-3.5V12l-6 3-6-3Z',
  skills: 'm4 5 4-2 4 2 4-2 4 2v14l-4 2-4-2-4 2-4-2V5Zm4 3v8m8-8v8m-4-6v8',
  research: 'M6 3h9l3 3v15H6V3Zm9 0v4h3M9 12h6m-6 4h6',
  languages: 'M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4H6.5A2.5 2.5 0 0 1 4 12.5v-7Z',
};

const hobbyIconPaths: Record<Hobby['icon'], string> = {
  agents: 'M8 8h8v8H8V8Zm-5 2h5m8 0h5M10 3v5m4-5v5M10 16v5m4-5v5M5 5l3 3m11-3-3 3m0 8 3 3m-11-3-3 3',
  music: 'M9 18V5l10-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3Zm10-2a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z',
  travel: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-7-9h14M12 3c2 2.2 3 5.2 3 9s-1 6.8-3 9c-2-2.2-3-5.2-3-9s1-6.8 3-9Z',
  'table-tennis': 'M5 19 19 5m-3 11 3 3m-8-8 3 3M5 5l4 4',
};

const iconPaths = (icon: AboutIcon | Hobby['icon']) =>
  icon in highlightIconPaths ? highlightIconPaths[icon as AboutIcon] : hobbyIconPaths[icon as Hobby['icon']];
---

<section
  class="scroll-mt-24 border-y border-amber-200 bg-amber-50/80 dark:border-amber-900/70 dark:bg-amber-950/30"
  id="about"
  aria-labelledby="about-title"
>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">A little about me</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl" id="about-title">
        From mathematical foundations to robust AI systems.
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-8 text-slate-700 dark:text-slate-300">
        {aboutIntro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <aside class="rounded-2xl border border-indigo-100 bg-indigo-50 p-6 dark:border-indigo-900/70 dark:bg-indigo-950/40 sm:p-8" aria-label="About summary">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-700 dark:text-indigo-300">My north star</p>
      <p class="mt-4 text-xl font-semibold leading-8 text-slate-950 dark:text-white">
        Build thoughtfully. Explain clearly. Leave systems better than I found them.
      </p>
    </aside>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {aboutHighlights.map((highlight) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <svg class="h-8 w-8 text-indigo-700 dark:text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={highlightIconPaths[highlight.icon]} />
        </svg>
        <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">{highlight.title}</p>
        {highlight.items ? (
          <ul class="mt-3 list-disc space-y-3 pl-5 text-sm leading-6 text-slate-700 marker:text-indigo-600 dark:text-slate-300 dark:marker:text-indigo-400">
            {highlight.items.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          <>
            <h3 class="mt-2 font-bold text-slate-950 dark:text-white">{highlight.value}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{highlight.description}</p>
          </>
        )}
      </article>
    ))}
    </div>

    <section class="mt-16" aria-labelledby="hobbies-title">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Beyond the code</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white" id="hobbies-title">What keeps me curious</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {hobbies.map((hobby) => (
        <article class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <svg class="mt-1 h-7 w-7 shrink-0 text-indigo-700 dark:text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={iconPaths(hobby.icon)} />
          </svg>
          <div>
            <h3 class="font-bold text-slate-950 dark:text-white">{hobby.name}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{hobby.description}</p>
          </div>
        </article>
      ))}
    </div>
    </section>
  </div>
</section>
