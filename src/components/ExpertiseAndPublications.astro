---
import { languages, publications } from '../data';
import { publicationTypes, type PublicationEntry } from '../data/schema';

const competencies = [
  {
    category: 'AI systems',
    skills: ['Multi-Agent Orchestration', 'LLM & VLM Workflows', 'Computer Vision'],
  },
  {
    category: 'ML engineering',
    skills: ['Deep Learning', 'MLOps', 'Model Validation & Edge Deployment'],
  },
  {
    category: 'Systems & research',
    skills: ['C++ / Python', 'Video Compression (HEVC / VVC)', 'Signal Processing'],
  },
];

const typedPublications = publications as PublicationEntry[];
const publicationGroups = publicationTypes.map((type) => ({
  type,
  items: typedPublications.filter((publication) => publication.type === type),
}));
---

<section class="mx-auto max-w-5xl px-6 py-16 sm:py-24" aria-labelledby="expertise-title">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700">Expertise</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl" id="expertise-title">
      Applied skills and communication
    </h2>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="skills-title">
      <h3 class="text-2xl font-bold text-slate-950" id="skills-title">Core competencies</h3>
      <div class="mt-6 space-y-6">
        {competencies.map((group) => (
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wide text-slate-600">{group.category}</h4>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-800">{skill}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section
      class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
      id="languages"
      aria-labelledby="languages-title"
    >
      <h3 class="text-2xl font-bold text-slate-950" id="languages-title">Languages</h3>
      <dl class="mt-6 divide-y divide-slate-200">
        {languages.map((language) => (
          <div class="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6" lang={language.code}>
            <dt class="font-bold text-slate-950">{language.language}</dt>
            <dd class="text-slate-700">{language.level}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</section>

<section
  class="mx-auto max-w-5xl px-6 py-16 sm:py-24"
  id="publications"
  aria-labelledby="publications-title"
>
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700">Research</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl" id="publications-title">
      Selected publications
    </h2>
    <p class="mt-4 text-lg leading-8 text-slate-700">
      Doctoral and peer-reviewed work on video coding, adaptive filtering, and perceptual quality.
    </p>
  </div>

  <div class="mt-10 space-y-10">
    {publicationGroups.map((group) => (
      <section aria-labelledby={`publication-group-${group.type.toLowerCase().replace(' ', '-')}`}>
        <h3
          class="text-xl font-bold text-slate-950"
          id={`publication-group-${group.type.toLowerCase().replace(' ', '-')}`}
        >
          {group.type}
        </h3>
        <ol class="mt-4 grid gap-5">
          {group.items.map((publication) => (
            <li
              class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
              data-publication-id={publication.id}
            >
              <article aria-labelledby={`${publication.id}-title`}>
                <p class="text-sm font-bold text-indigo-700">{publication.year}</p>
                <h4 class="mt-2 text-lg font-bold leading-7 text-slate-950" id={`${publication.id}-title`}>
                  {publication.title}
                </h4>
                <p class="mt-2 text-sm leading-6 text-slate-600">{publication.authors}</p>
                <p class="mt-2 leading-7 text-slate-700">{publication.venue}</p>
                {(publication.doi || publication.paperUrl) && (
                  <div class="mt-4 flex flex-wrap gap-4">
                    {publication.doi && (
                      <a
                        class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700"
                        href={publication.doi}
                        aria-label={`Open DOI for ${publication.title}`}
                      >
                        DOI
                      </a>
                    )}
                    {publication.paperUrl && (
                      <a
                        class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700"
                        href={publication.paperUrl}
                        aria-label={`Open official record for ${publication.title}`}
                      >
                        Official record
                      </a>
                    )}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</section>
