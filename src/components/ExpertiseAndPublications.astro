---
import { publications } from '../data';
import { publicationTypes, type PublicationEntry } from '../data/schema';

const typedPublications = publications as PublicationEntry[];
const publicationGroups = publicationTypes.map((type) => ({
  type,
  items: typedPublications.filter((publication) => publication.type === type),
}));
---

<section
  class="border-y border-sky-200 bg-sky-50/70 dark:border-sky-900/70 dark:bg-sky-950/25"
  id="publications"
  aria-labelledby="publications-title"
>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">Research</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl" id="publications-title">
      Selected publications
    </h2>
    <p class="mt-4 text-lg leading-8 text-slate-700 dark:text-slate-300">
      Doctoral and peer-reviewed work on video coding, adaptive filtering, and perceptual quality.
    </p>
    </div>

    <div class="mt-10 space-y-10">
    {publicationGroups.map((group) => (
      <section aria-labelledby={`publication-group-${group.type.toLowerCase().replace(' ', '-')}`}>
        <h3
          class="text-xl font-bold text-slate-950 dark:text-white"
          id={`publication-group-${group.type.toLowerCase().replace(' ', '-')}`}
        >
          {group.type}
        </h3>
        <ol class="mt-4 grid gap-5">
          {group.items.map((publication) => (
            <li
              class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
              data-publication-id={publication.id}
            >
              <article class="flex flex-col gap-5 sm:flex-row sm:items-start" aria-labelledby={`${publication.id}-title`}>
                <button
                  class="group relative block w-full shrink-0 overflow-hidden rounded-xl text-left outline-offset-4 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:focus-visible:outline-indigo-300 sm:w-56"
                  type="button"
                  data-publication-open={publication.id}
                  aria-haspopup="dialog"
                  aria-controls={`${publication.id}-dialog`}
                  aria-label={`Open details for ${publication.title}`}
                >
                  <img class="aspect-video w-full object-cover transition duration-300 group-hover:scale-105 motion-reduce:transition-none" src={publication.image} alt={`Concept illustration for ${publication.title}`} width="1200" height="676" loading="lazy" decoding="async" />
                  <span class="absolute inset-x-0 bottom-0 bg-slate-950/85 px-4 py-3 text-sm font-semibold text-white">View publication details</span>
                </button>
                <div>
                  <p class="text-sm font-bold text-indigo-700 dark:text-indigo-300">{publication.type} · {publication.year}</p>
                  <h4 class="mt-2 text-lg font-bold leading-7 text-slate-950 dark:text-white" id={`${publication.id}-title`}>{publication.title}</h4>
                  <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Select the illustration to view publication details.</p>
                </div>
              </article>

              <dialog class="w-[min(42rem,calc(100vw-2rem))] rounded-2xl border border-slate-200 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/70 dark:border-slate-700 dark:bg-slate-900 dark:text-white" id={`${publication.id}-dialog`} aria-labelledby={`${publication.id}-dialog-title`}>
                <article class="p-6 sm:p-8">
                  <div class="flex items-start justify-between gap-5">
                    <div><p class="text-sm font-bold text-indigo-700 dark:text-indigo-300">{publication.type} · {publication.year}</p><h4 class="mt-2 text-2xl font-bold leading-8" id={`${publication.id}-dialog-title`}>{publication.title}</h4></div>
                    <form method="dialog"><button class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-xl font-semibold outline-offset-4 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:border-slate-600 dark:hover:bg-slate-800 dark:focus-visible:outline-indigo-300" aria-label={`Close details for ${publication.title}`} type="submit">×</button></form>
                  </div>
                  <img class="mt-6 aspect-video w-full rounded-xl object-cover" src={publication.image} alt="" width="1200" height="676" loading="lazy" decoding="async" />
                  <p class="mt-6 text-lg leading-8 text-slate-700 dark:text-slate-300">{publication.description}</p>
                  <dl class="mt-6 space-y-4 text-sm leading-6"><div><dt class="font-bold text-slate-950 dark:text-white">Authors</dt><dd class="mt-1 text-slate-700 dark:text-slate-300">{publication.authors}</dd></div><div><dt class="font-bold text-slate-950 dark:text-white">Venue</dt><dd class="mt-1 text-slate-700 dark:text-slate-300">{publication.venue}</dd></div></dl>
                  {(publication.doi || publication.paperUrl) && <div class="mt-7 flex flex-wrap gap-4">{publication.doi && <a class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300" href={publication.doi}>DOI</a>}{publication.paperUrl && <a class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300" href={publication.paperUrl}>Official record</a>}</div>}
                </article>
              </dialog>
            </li>
          ))}
        </ol>
      </section>
    ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-publication-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(`${button.dataset.publicationOpen}-dialog`);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
</script>
