---
import type { ProjectEntry } from '../data/schema';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
  data-project-id={project.id}
  aria-labelledby={`${project.id}-title`}
>
  <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wide">
    {project.featured && <span class="rounded-full bg-indigo-100 px-3 py-1 text-indigo-900">Featured</span>}
    <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700">{project.category}</span>
  </div>

  <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-950" id={`${project.id}-title`}>
    {project.title}
  </h3>
  <p class="mt-1 font-semibold text-indigo-700">{project.subtitle}</p>
  <p class="mt-4 leading-7 text-slate-700">{project.description}</p>

  <div class="mt-5 rounded-xl bg-slate-50 p-4">
    <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Engineering impact</p>
    <p class="mt-2 leading-7 text-slate-700">{project.impact}</p>
  </div>

  <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Technologies used for ${project.title}`}>
    {project.techStack.map((technology) => (
      <li class="rounded-md border border-slate-200 px-2.5 py-1 text-sm font-medium text-slate-700">
        {technology}
      </li>
    ))}
  </ul>

  {(project.githubUrl || project.demoUrl) && (
    <div class="mt-auto flex flex-wrap gap-3 pt-6">
      {project.githubUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700"
          href={project.githubUrl}
          aria-label={`View ${project.title} source code`}
        >
          View source code
        </a>
      )}
      {project.demoUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700"
          href={project.demoUrl}
          aria-label={`Open ${project.title} demo`}
        >
          Open demo
        </a>
      )}
    </div>
  )}
</article>
