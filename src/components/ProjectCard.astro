---
import type { ProjectEntry } from '../data/schema';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const projectVisuals = {
  'mindgrow-stories': {
    src: '/assets/projects/mindgrow-stories-hero.webp',
    alt: "Concept illustration of MindGrow Stories connecting AI workflow stages to an illustrated children's book",
  },
  'wizarding-story-engine': {
    src: '/assets/projects/wizarding-story-engine-hero.webp',
    alt: 'Concept illustration of a multi-agent writing workflow around an open book',
  },
} as const;
const projectVisual = projectVisuals[project.id as keyof typeof projectVisuals];
---

<article
  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-5"
  data-project-id={project.id}
  aria-labelledby={`${project.id}-title`}
>
  <img
    class="aspect-video w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
    src={projectVisual.src}
    alt={projectVisual.alt}
    width="1440"
    height="810"
    loading="lazy"
    decoding="async"
  />

  <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${project.id}-title`}>
    {project.title}
  </h3>

  <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Technologies used for ${project.title}`}>
    {project.techStack.map((technology) => (
      <li class="rounded-md border border-slate-200 px-2.5 py-1 text-sm font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200">
        {technology}
      </li>
    ))}
  </ul>

  <a
    class="mt-auto inline-flex w-fit pt-6 font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
    href={`/projects/${project.id}/`}
    aria-label={`Read the ${project.title} case study`}
  >
    Read case study <span aria-hidden="true">→</span>
  </a>

  {(project.githubUrl || project.demoUrl) && (
    <div class="flex flex-wrap gap-3 pt-4">
      {project.githubUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
          href={project.githubUrl}
          aria-label={`View ${project.title} source code`}
        >
          View source code
        </a>
      )}
      {project.demoUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
          href={project.demoUrl}
          aria-label={`Open ${project.title} demo`}
        >
          Open demo
        </a>
      )}
    </div>
  )}
</article>
