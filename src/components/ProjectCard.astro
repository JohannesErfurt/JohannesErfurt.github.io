---
import type { ProjectEntry } from '../data/schema';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const projectVisuals = {
  'mindgrow-stories': {
    src: '/assets/projects/mindgrow-stories-hero.webp',
    alt: "Concept illustration of MindGrow Stories connecting AI workflow stages to an illustrated children's book",
  },
  'wizarding-story-engine': {
    src: '/assets/projects/wizarding-story-engine-hero.webp',
    alt: 'Concept illustration of a multi-agent writing workflow around an open book',
  },
} as const;
const projectVisual = projectVisuals[project.id as keyof typeof projectVisuals];
---

<article
  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-5"
  data-project-id={project.id}
  aria-labelledby={`${project.id}-title`}
>
  <button class="group relative block w-full overflow-hidden rounded-xl border border-slate-200 text-left outline-offset-4 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:border-slate-700 dark:focus-visible:outline-indigo-300" type="button" data-project-open={project.id} aria-haspopup="dialog" aria-controls={`${project.id}-dialog`} aria-label={`Open summary for ${project.title}`}>
    <img class="aspect-video w-full object-cover transition duration-300 group-hover:scale-105 motion-reduce:transition-none" src={projectVisual.src} alt={projectVisual.alt} width="1440" height="810" loading="lazy" decoding="async" />
  </button>

  <h3 class="mt-5 text-2xl font-bold tracking-tight text-slate-950 dark:text-white" id={`${project.id}-title`}>
    {project.title}
  </h3>

  <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Technologies used for ${project.title}`}>
    {project.techStack.map((technology) => (
      <li class="rounded-md border border-slate-200 px-2.5 py-1 text-sm font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200">
        {technology}
      </li>
    ))}
  </ul>

  <a
    class="mt-auto inline-flex w-fit pt-6 font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
    href={`/projects/${project.id}/`}
    aria-label={`Read the ${project.title} case study`}
  >
    Read case study <span aria-hidden="true">→</span>
  </a>

  {(project.githubUrl || project.demoUrl) && (
    <div class="flex flex-wrap gap-3 pt-4">
      {project.githubUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
          href={project.githubUrl}
          aria-label={`View ${project.title} source code`}
        >
          View source code
        </a>
      )}
      {project.demoUrl && (
        <a
          class="font-semibold text-indigo-700 underline decoration-indigo-300 underline-offset-4 outline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
          href={project.demoUrl}
          aria-label={`Open ${project.title} demo`}
        >
          Open demo
        </a>
      )}
    </div>
  )}
</article>

<dialog class="max-h-[calc(100vh-2rem)] w-[min(42rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/70 dark:border-slate-700 dark:bg-slate-900 dark:text-white" id={`${project.id}-dialog`} aria-labelledby={`${project.id}-dialog-title`}>
  <article class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-5"><div><p class="text-sm font-bold uppercase tracking-wide text-indigo-700 dark:text-indigo-300">{project.category}</p><h3 class="mt-2 text-2xl font-bold leading-8" id={`${project.id}-dialog-title`}>{project.title}</h3></div><form method="dialog"><button class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-xl font-semibold outline-offset-4 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:border-slate-600 dark:hover:bg-slate-800 dark:focus-visible:outline-indigo-300" aria-label={`Close summary for ${project.title}`} type="submit">×</button></form></div>
    <p class="mt-6 leading-7 text-slate-700 dark:text-slate-300">{project.description}</p>
    <div class="mt-6 rounded-xl bg-slate-50 p-4 dark:bg-slate-950"><p class="text-xs font-bold uppercase tracking-wide text-slate-600 dark:text-slate-400">Engineering impact</p><p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{project.impact}</p></div>
  </article>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(`${button.dataset.projectOpen}-dialog`);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
</script>
