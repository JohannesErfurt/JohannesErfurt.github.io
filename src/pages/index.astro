---
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ExpertiseAndPublications from '../components/ExpertiseAndPublications.astro';
import AboutProfile from '../components/AboutProfile.astro';
import HeroSummary from '../components/HeroSummary.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Dr.-Ing. Johannes Erfurt | AI Systems and Computer Vision';
const description = 'AI systems engineer specializing in computer vision, multi-agent applications, MLOps, and image/video coding.';
---

<BaseLayout title={pageTitle} description={description}>
  <HeroSummary />

  <AboutProfile />

  <ExperienceTimeline />

  <ProjectShowcase />

  <ExpertiseAndPublications />
</BaseLayout>
